      "title": "Stop Level",
      "type": "number"
    },
    "target_2atr": {
      "title": "Target 2Atr",
      "type": "number"
    },
    "ticker": {
      "title": "Ticker",
      "type": "string"
    },
    "timeframe": {
      "title": "Timeframe",
      "type": "string"
    },
    "timestamp_utc": {
      "format": "date-time",
      "title": "Timestamp Utc",
      "type": "string"
    },
