      "title": "Is Confirmed Bar",
      "type": "boolean"
    },
    "price": {
      "title": "Price",
      "type": "number"
    },
    "provider_metadata": {
      "additionalProperties": true,
      "title": "Provider Metadata",
      "type": "object"
    },
    "provider_name": {
      "title": "Provider Name",
      "type": "string"
    },
    "quality_attestation": {
      "$ref": "#/$defs/QualityAttestation"
    },
    "quality_attestation_reasons": {
      "items": {
        "type": "string"
      },
