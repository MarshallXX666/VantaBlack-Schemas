    "atr": {
      "title": "Atr",
      "type": "number"
    },
    "bar_close_timestamp_utc": {
      "format": "date-time",
      "title": "Bar Close Timestamp Utc",
      "type": "string"
    },
    "breakout_strength": {
      "title": "Breakout Strength",
      "type": "number"
    },
    "candle_body_ratio": {
      "title": "Candle Body Ratio",
      "type": "number"
    },
    "candle_wick_ratio": {
      "title": "Candle Wick Ratio",
      "type": "number"
    },
    "confidence": {
      "title": "Confidence",
      "type": "number"
    },
    "direction": {
      "$ref": "#/$defs/Direction"
    },
    "efficiency_ratio": {
      "title": "Efficiency Ratio",
      "type": "number"
    },
    "event_schema_version": {
