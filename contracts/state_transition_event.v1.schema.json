    "target_2atr",
    "confidence",
    "breakout_strength",
    "efficiency_ratio",
    "trend_bars",
    "trend_bars_aligned",
    "hl2_src",
    "htf_4h_trend",
    "htf_1d_trend",
    "htf_aligned_count",
    "candle_body_ratio",
    "candle_wick_ratio",
    "is_confirmed_bar"
